generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id       String    @id @default(cuid())
  name     String
  handle   String    @unique
  products Product[]
  collections Collection[]
  carts Cart[]
  priceRules PriceRule[]
}

model PriceRule {
  id         String @id @default(cuid())
  storeId    String
  code       String?
  type       String
  value      Int
  conditions Json
  usageLimit Int?
  uses       Int @default(0)
  startsAt   DateTime
  endsAt     DateTime?
  store      Store @relation(fields: [storeId], references: [id])
  @@unique([storeId, code])
}

model Cart {
  id         String     @id @default(cuid())
  storeId    String
  customerId String?
  updatedAt  DateTime   @updatedAt
  store      Store      @relation(fields: [storeId], references: [id])
  lines      CartLine[]
  orders     Order[]
}

model Order {
  id             String @id @default(cuid())
  cartId         String
  idempotencyKey String @unique
  status         String @default("pending")
  totalCents     Int
  currency       String
  cart           Cart @relation(fields: [cartId], references: [id])
  lines          OrderLine[]
  payments       Payment[]
  fulfillments   Fulfillment[]

  @@index([cartId, status])
}

model OrderLine {
  id             String @id @default(cuid())
  orderId        String
  variantId      String
  quantity       Int
  unitPriceCents Int
  order          Order @relation(fields: [orderId], references: [id])
  fulfillmentLines FulfillmentLine[]

  @@index([orderId, variantId])
}

model Fulfillment {
  id             String @id @default(cuid())
  orderId        String
  idempotencyKey String @unique
  carrier        String?
  trackingNumber String?
  createdAt      DateTime @default(now())
  order          Order @relation(fields: [orderId], references: [id])
  lines          FulfillmentLine[]

  @@index([orderId, createdAt(sort: Desc)])
}

model FulfillmentLine {
  fulfillmentId String
  orderLineId   String
  quantity      Int
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderLine     OrderLine @relation(fields: [orderLineId], references: [id])

  @@id([fulfillmentId, orderLineId])
}

model Payment {
  id               String @id @default(cuid())
  orderId          String
  providerChargeId String @unique
  idempotencyKey   String @unique
  amountCents      Int
  status           String
  order            Order @relation(fields: [orderId], references: [id])
  refunds          Refund[]
}

model Refund {
  id               String @id @default(cuid())
  paymentId        String
  providerRefundId String @unique
  idempotencyKey   String @unique
  amountCents      Int
  status           String
  payment          Payment @relation(fields: [paymentId], references: [id])
}

model CartLine {
  id                 String @id @default(cuid())
  cartId             String
  variantId          String
  quantity           Int
  priceSnapshotCents Int
  cart               Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  title       String
  handle      String
  description String   @default("")
  priceCents  Int
  status      String   @default("draft")
  metaTitle   String?
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id])
  options     ProductOption[]
  variants    Variant[]
  media       ProductMedia[]
  collections ProductsOnCollections[]

  @@unique([storeId, handle])
  @@index([storeId, status, createdAt(sort: Desc)])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  kind      String  @default("image")
  url       String
  altText   String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

model Collection {
  id        String   @id @default(cuid())
  storeId   String
  title     String
  handle    String
  kind      String
  rule      Json?
  store     Store    @relation(fields: [storeId], references: [id])
  products  ProductsOnCollections[]

  @@unique([storeId, handle])
}

model ProductsOnCollections {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int
  values    String[]
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@unique([productId, position])
}

model Variant {
  id          String  @id @default(cuid())
  productId   String
  sku         String
  priceCents  Int
  selections Json
  identity    String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   InventoryItem[]

  @@unique([productId, sku])
  @@unique([productId, identity])
}

model InventoryItem {
  id         String @id @default(cuid())
  variantId  String
  locationId String
  onHand     Int
  reserved   Int    @default(0)
  variant    Variant @relation(fields: [variantId], references: [id])
  reservations InventoryReservation[]

  @@unique([variantId, locationId])
}

model InventoryReservation {
  id              String @id @default(cuid())
  inventoryItemId String
  cartId          String
  quantity        Int
  status          String @default("active")
  expiresAt       DateTime
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  @@index([status, expiresAt])
}
