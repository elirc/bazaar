{
  "name": "bazaar",
  "version": "0.0.0",
  "private": true,
  "description": "A Shopify-lite teaching platform built as fifteen reviewable sprints.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gate": "pnpm run lint && pnpm run typecheck && turbo run test build",
    "performance:gate": "node scripts/cache-performance-gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "tsup": "^8.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
